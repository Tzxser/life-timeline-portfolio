{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "life-timeline",
  "version": "0.2.14",
  "identifier": "com.tzxser.lifetimeline",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:desktop",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "life-timeline",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/attachments/**",
          "$APPLOCALDATA/thumbnails/**",
          "$APPLOCALDATA/**/attachments/**",
          "$APPLOCALDATA/**/thumbnails/**"
        ]
      },
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDOTU4OTg4RDAyRTRCOTEKUldTUlN5N1FpSW1Wckw1TzF4NGhVVktDZkFxUmdGNzBYUzdQWTRUdUtTcklTcTBleStESThzVzQK",
      "endpoints": [
        "https://life-timeline.xinciqq.top/updates/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
