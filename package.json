{
  "name": "life-timeline",
  "version": "0.2.14",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-schedule-assets.mjs && next dev",
    "build": "node scripts/prepare-schedule-assets.mjs && next build",
    "build:desktop": "pnpm build && node scripts/prune-desktop-assets.mjs",
    "check:static": "node scripts/check-static-output.mjs",
    "check:toolchain": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/check-toolchain.ps1",
    "e2e:web": "node scripts/e2e-web-acceptance.mjs",
    "e2e:native": "node scripts/e2e-native-acceptance.mjs",
    "preview:static": "node scripts/serve-static.mjs",
    "start": "next start",
    "test": "node --experimental-strip-types --experimental-loader ./tests/ts-loader.mjs --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
